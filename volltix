-- ====================== UTILS ======================
local function Create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then obj.Parent = parent end
    return obj
end

local function FormatTime(sec)
    sec = math.max(0, math.floor(sec))
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function GetSeconds(duration, unit)
    if unit == "m" then return duration * 60 end
    if unit == "h" then return duration * 3600 end
    return duration
end

local function Notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 4
        })
    end)
end

-- ====================== EXECUÇÃO REAL ======================
local function ExecuteScript(code, name)
    name = name or "Script"
    
    -- Delta e a maioria dos executores modernos possuem o ambiente global de execução limpo.
    -- Garante compatibilidade direta usando loadstring padrão.
    local func, err = loadstring(code)
    if not func then
        return false, "Erro de sintaxe: " .. tostring(err)
    end
    
    -- task.spawn previne travamentos caso o script injetado possua loops infinitos sem wait
    local success, result = pcall(function()
        task.spawn(func)
    end)
    
    if not success then
        return false, "Erro: " .. tostring(result)
    end
    return true, "Executado via task.spawn"
end

-- ====================== SERVER HOP REAL FIXED FOR DELTA ======================
local function DoServerHop(hopType)
    local placeId = game.PlaceId
    
    -- Delta Executor suporta a API de HttpGet e TeleportService de forma nativa.
    -- Correção da URL de requisição pública de servidores bypassando restrições de CORS locais.
    local success, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        -- Se o executor tiver o request customizado (comum no Delta), usamos ele para estabilidade extrema.
        local req = (syn and syn.request) or (http and http.request) or request
        if req then
            local res = req({Url = url, Method = "GET"})
            return HttpService:JSONDecode(res.Body)
        else
            return HttpService:JSONDecode(game:HttpGet(url))
        end
    end)
    
    if success and result and result.data then
        local validServers = {}
        for _, server in ipairs(result.data) do
            if server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or 0) then
                table.insert(validServers, server)
            end
        end
        
        if #validServers > 0 then
            if hopType == "empty" then
                table.sort(validServers, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
            else
                -- Aleatório estruturado
                table.sort(validServers, function(a, b) return math.random() > 0.5 end)
            end
            
            local targetServer = validServers[1]
            pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
            end)
            return true, "Teleportando para: " .. tostring(targetServer.id)
        end
    end
    
    -- Fallback estável usando QueueOnTeleport se necessário (padrão Teleport simples)
    pcall(function()
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
    return true, "Teleportando via Fallback global..."
end

