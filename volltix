-- SISTEMA DE SEQUÊNCIA TOTALMENTE SEGURO CONTRA CRASH NO DELTA
StartSeqBtn.MouseButton1Click:Connect(function()
    if IsSequenceRunning then
        IsSequenceRunning = false
        StartSeqBtn.Text = "▶ Sequência"
        SeqStatus.Text = "Interrompido"
        return
    end
    IsSequenceRunning = true
    StartSeqBtn.Text = "⏹ Parar"
    task.spawn(function()
        for _, tab in ipairs(Tabs) do
            if not IsSequenceRunning then break end
            ActiveTabId = tab.Id
            CodeBox.Text = tab.Code
            RefreshTabs()
            ExecuteScript(tab.Code, tab.Name)
            local t = GetSeconds(tab.Duration, tab.Unit)
            while t > 0 and IsSequenceRunning do
                SeqStatus.Text = tab.Name .. " (" .. t .. "s)"
                task.wait(1)
                t -= 1
            end
        end
        IsSequenceRunning = false
        StartSeqBtn.Text = "▶ Sequência"
        SeqStatus.Text = "Pronto"
    end)
end)

-- SISTEMA SERVER HOP ATIVO
StartHopBtn.MouseButton1Click:Connect(function()
    IsHopRunning = true
    StartHopBtn.Visible = false
    StopHopBtn.Visible = true
    task.spawn(function()
        local t = HopDuration
        while t > 0 and IsHopRunning do
            HopCountdown.Text = FormatTime(t)
            task.wait(1)
            t -= 1
        end
        if IsHopRunning then
            FinalOverlay.Visible = true
            for count = 5, 0, -1 do
                FinalNumber.Text = tostring(count)
                task.wait(1)
            end
            DoServerHop(HopType)
        end
    end)
end)

