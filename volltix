local function RefreshTabs()
    for _, c in ipairs(TabsBar:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _, tab in ipairs(Tabs) do
        local btn = Create("TextButton", {
            Size = UDim2.fromOffset(85, 24),
            BackgroundColor3 = (tab.Id == ActiveTabId) and CurrentColor.Color or Color3.fromRGB(28, 32, 38),
            Text = tab.Name,
            TextColor3 = (tab.Id == ActiveTabId) and Color3.fromRGB(0,0,0) or Color3.fromRGB(210,210,210),
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            Parent = TabsBar,
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 5)}, btn)
        btn.MouseButton1Click:Connect(function()
            if IsSequenceRunning then return end
            for _, t in ipairs(Tabs) do
                if t.Id == ActiveTabId then t.Code = CodeBox.Text end
            end
            ActiveTabId = tab.Id
            CodeBox.Text = tab.Code
            RefreshTabs()
        end)
    end
end

local function RefreshHub()
    for _, c in ipairs(HubScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    for i, script in ipairs(HUB_SCRIPTS) do
        local card = Create("Frame", {
            Size = UDim2.new(1, -8, 0, 65),
            BackgroundColor3 = Color3.fromRGB(16, 20, 24),
            LayoutOrder = i,
            Parent = HubScroll,
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 8)}, card)

        local lockIcon = script.Password and "🔒 " or "🌐 "
        Create("TextLabel", {
            Size = UDim2.new(1, -100, 0, 20),
            Position = UDim2.fromOffset(10, 6),
            BackgroundTransparency = 1,
            Text = lockIcon .. script.Name,
            TextColor3 = CurrentColor.Color,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card,
        })

        Create("TextLabel", {
            Size = UDim2.new(1, -100, 0, 16),
            Position = UDim2.fromOffset(10, 26),
            BackgroundTransparency = 1,
            Text = "de " .. script.Author .. " • " .. script.Desc,
            TextColor3 = Color3.fromRGB(140, 140, 140),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card,
        })

        local runBtn = Create("TextButton", {
            Size = UDim2.fromOffset(75, 26),
            Position = UDim2.new(1, -85, 0.5, -13),
            BackgroundColor3 = CurrentColor.Color,
            Text = "Injetar",
            TextColor3 = Color3.fromRGB(0,0,0),
            Font = Enum.Font.GothamBlack,
            TextSize = 11,
            Parent = card,
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}, runBtn)

        runBtn.MouseButton1Click:Connect(function()
            if script.Password then
                PendingHubScript = script
                ScriptPassTitle.Text = "Senha: " .. script.Name
                ScriptPassInput.Text = ""
                ScriptPassModal.Visible = true
            else
                LoadingOverlay.Visible = true
                LoadingSub.Text = "Baixando dependências..."
                task.delay(1.5, function()
                    LoadingOverlay.Visible = false
                    AddLog("▶ Hub Exec: " .. script.Name, Color3.fromRGB(100, 255, 180))
                    local ok, msg = ExecuteScript(script.Code, script.Name)
                    if ok then
                        AddLog("✓ " .. script.Name .. " injetado com sucesso!", Color3.fromRGB(100, 255, 160))
                        Notify("V0ltiXX Hub", script.Name .. " executado!")
                    else
                        AddLog("✗ " .. msg, Color3.fromRGB(255, 80, 80))
                    end
                end)
            end
        end)
    end
end

-- Configurações de clique simples nativo
ExecuteBtn.MouseButton1Click:Connect(function()
    if IsSequenceRunning then return end
    for _, t in ipairs(Tabs) do
        if t.Id == ActiveTabId then t.Code = CodeBox.Text end
    end
    LoadingOverlay.Visible = true
    LoadingSub.Text = "Executando Thread..."
    task.delay(1, function()
        LoadingOverlay.Visible = false
        local tab
        for _, t in ipairs(Tabs) do if t.Id == ActiveTabId then tab = t break end end
        if not tab then return end
        local ok, msg = ExecuteScript(tab.Code, tab.Name)
        if ok then
            AddLog("✓ " .. tab.Name .. " executado com sucesso!", Color3.fromRGB(100, 255, 160))
        else
            AddLog("✗ " .. msg, Color3.fromRGB(255, 80, 80))
        end
    end)
end)

