-- ====================== PROCESSAMENTO DE LOGICA INTERNA ======================
local function AddLog(text, color)
    Create("TextLabel", {Size = UDim2.new(1, -12, 0, 16), BackgroundTransparency = 1, Text = "[" .. os.date("%H:%M:%S") .. "] " .. tostring(text), TextColor3 = color or Color3.fromRGB(180, 180, 180), Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = ConsoleBox})
end

local function ApplyColor(data)
    CurrentColor = data
    PanelStroke.Color, FloatStroke.Color, FloatBtn.TextColor3 = data.Color, data.Color, data.Color
    Title.TextColor3, ExecuteBtn.BackgroundColor3, StartHopBtn.BackgroundColor3 = data.Color, data.Color, data.Color
    OpenConfirmBtn.BackgroundColor3, ScriptPassEnter.BackgroundColor3, HopCountdown.TextColor3 = data.Color, data.Color, data.Color
    LoadingText.TextColor3, CurrentColorLabel.TextColor3 = data.Color, data.Color
    CurrentColorLabel.Text = "Cor Ativa: " .. data.Name
    HopEmptyStroke.Color, OpenBoxStroke.Color, ScriptPassBoxStroke.Color = data.Color, data.Color, data.Color
    AddLog("Tema alterado para: " .. data.Name, data.Color)
end

local function ShowView(name)
    for id, view in pairs(Views) do view.Visible = (id == name) end
    for id, btn in pairs(NavButtons) do
        btn.BackgroundColor3 = (id == name) and Color3.fromRGB(30, 40, 35) or Color3.fromRGB(15, 18, 22)
    end
end

local function RefreshTabs()
    for _, c in ipairs(TabsBar:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    for _, tab in ipairs(Tabs) do
        local btn = Create("TextButton", {Size = UDim2.fromOffset(85, 24), BackgroundColor3 = (tab.Id == ActiveTabId) and CurrentColor.Color or Color3.fromRGB(28, 32, 38), Text = tab.Name, TextColor3 = (tab.Id == ActiveTabId) and Color3.fromRGB(0,0,0) or Color3.fromRGB(210,210,210), Font = Enum.Font.GothamBold, TextSize = 11, Parent = TabsBar})
        Create("UICorner", {CornerRadius = UDim.new(0, 5)}, btn)
        btn.MouseButton1Click:Connect(function()
            if IsSequenceRunning then return end
            for _, t in ipairs(Tabs) do if t.Id == ActiveTabId then t.Code = CodeBox.Text end end
            ActiveTabId = tab.Id
            CodeBox.Text = tab.Code
            RefreshTabs()
        end)
    end
end

local function RefreshHub()
    for _, c in ipairs(HubScroll:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    for i, script in ipairs(HUB_SCRIPTS) do
        local card = Create("Frame", {Size = UDim2.new(1, -8, 0, 65), BackgroundColor3 = Color3.fromRGB(16, 20, 24), LayoutOrder = i, Parent = HubScroll})
        Create("UICorner", {CornerRadius = UDim.new(0, 8)}, card)
        
        local lockIcon = script.Password and "🔒 " or "🌐 "
        Create("TextLabel", {Size = UDim2.new(1, -100, 0, 20), Position = UDim2.fromOffset(10, 6), BackgroundTransparency = 1, Text = lockIcon .. script.Name, TextColor3 = CurrentColor.Color, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = card})
        Create("TextLabel", {Size = UDim2.new(1, -100, 0, 16), Position = UDim2.fromOffset(10, 26), BackgroundTransparency = 1, Text = "Autor: " .. script.Author .. " • " .. script.Desc, TextColor3 = Color3.fromRGB(140, 140, 140), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = card})
        
        local runBtn = Create("TextButton", {Size = UDim2.fromOffset(75, 26), Position = UDim2.new(1, -85, 0.5, -13), BackgroundColor3 = CurrentColor.Color, Text = "Injetar", TextColor3 = Color3.fromRGB(0,0,0), Font = Enum.Font.GothamBlack, TextSize = 11, Parent = card})
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}, runBtn)
        
        runBtn.MouseButton1Click:Connect(function()
            if script.Password then
                PendingHubScript = script
                ScriptPassTitle.Text = "Senha Requerida: " .. script.Name
                ScriptPassInput.Text = ""
                ScriptPassModal.Visible = true
            else
                LoadingOverlay.Visible = true
                LoadingSub.Text = "Alocando instâncias..."
                task.delay(0.6, function()
                    LoadingOverlay.Visible = false
                    local ok, msg = ExecuteScript(script.Code, script.Name)
                    if ok then
                        AddLog("✓ " .. script.Name .. " injetado com sucesso.", Color3.fromRGB(100, 255, 160))
                        Notify("V0ltiXX Hub", script.Name .. " executado!")
                    else
                        AddLog("✗ Erro: " .. msg, Color3.fromRGB(255, 80, 80))
                    end
                end)
            end
        end)
    end
end

-- ====================== CONEXÕES DE EVENTOS PRINCIPAIS ======================
ExecuteBtn.MouseButton1Click:Connect(function()
    if IsSequenceRunning then return end
    for _, t in ipairs(Tabs) do if t.Id == ActiveTabId then t.Code = CodeBox.Text end end
    LoadingOverlay.Visible = true
    task.delay(0.4, function()
        LoadingOverlay.Visible = false
        local tab
        for _, t in ipairs(Tabs) do if t.Id == ActiveTabId then tab = t break end end
        if not tab then return end
        local ok, msg = ExecuteScript(tab.Code, tab.Name)
        AddLog(ok and ("✓ " .. tab.Name .. " processado.") or ("✗ " .. msg), ok and Color3.fromRGB(100, 255, 160) or Color3.fromRGB(255, 80, 80))
    end)
end)

ClearBtn.MouseButton1Click:Connect(function() CodeBox.Text = "" end)

AddTabBtn.MouseButton1Click:Connect(function()
    if IsSequenceRunning then return end
    local newId = #Tabs + 1
    table.insert(Tabs, {Id = newId, Name = "Aba " .. newId, Code = "-- Script da Aba " .. newId, Duration = 15, Unit = "s"})
    ActiveTabId = newId
    CodeBox.Text = Tabs[#Tabs].Code
    RefreshTabs()
end)

OpenScriptBtn.MouseButton1Click:Connect(function() OpenModal.Visible = true end)
OpenCancelBtn.MouseButton1Click:Connect(function() OpenModal.Visible = false end)
OpenConfirmBtn.MouseButton1Click:Connect(function()
    if #OpenCodeBox.Text > 0 then
        CodeBox.Text = OpenCodeBox.Text
        AddLog("Estrutura textual importada com sucesso.", Color3.fromRGB(100, 255, 180))
    end
    OpenModal.Visible = false
end)

StartSeqBtn.MouseButton1Click:Connect(function()
    if IsSequenceRunning then
        IsSequenceRunning = false
        StartSeqBtn.Text = "▶ Sequência"
        SeqStatus.Text = "Cancelado"
        return
    end
    IsSequenceRunning = true
    StartSeqBtn.Text = "⏹ Parar"
    task.spawn(function()
        for _, tab in ipairs(Tabs) do
            if not IsSequenceRunning then break end
            ActiveTabId = tab.Id
            CodeBox.Text = tab.Code
            RefreshTabs()
            ExecuteScript(tab.Code, tab.Name)
            local t = tab.Duration
            while t > 0 and IsSequenceRunning do
                SeqStatus.Text = tab.Name .. " (" .. t .. "s)"
                task.wait(1)
                t -= 1
            end
        end
        IsSequenceRunning, StartSeqBtn.Text, SeqStatus.Text = false, "▶ Sequência", "Pronto"
    end)
end)

StartHopBtn.MouseButton1Click:Connect(function()
    IsHopRunning, StartHopBtn.Visible, StopHopBtn.Visible = true, false, true
    task.spawn(function()
        local t = HopDuration
        while t > 0 and IsHopRunning do
            HopCountdown.Text = FormatTime(t)
            task.wait(1)
            t -= 1
        end
        if IsHopRunning then DoServerHop(HopType) end
    end)
end)

StopHopBtn.MouseButton1Connect and StopHopBtn.MouseButton1Click:Connect(function()
    IsHopRunning, StartHopBtn.Visible, StopHopBtn.Visible = false, true, false
    HopCountdown.Text = "--:--:--"
end)

HopEmptyBtn.MouseButton1Click:Connect(function() HopType = "empty" HopEmptyStroke.Enabled = true AddLog("Filtro Hop alternado: Menor Lotação", CurrentColor.Color) end)
HopPublicBtn.MouseButton1Click:Connect(function() HopType = "public" HopEmptyStroke.Enabled = false AddLog("Filtro Hop alternado: Randômico", CurrentColor.Color) end)
FloatBtn.MouseButton1Click:Connect(function() MainPanel.Visible = not MainPanel.Visible end)
CloseBtn.MouseButton1Click:Connect(function() MainPanel.Visible = false end)
ClearConsoleBtn.MouseButton1Click:Connect(function() for _, c in ipairs(ConsoleBox:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end end)
ScriptPassCancel.MouseButton1Click:Connect(function() ScriptPassModal.Visible = false end)

ScriptPassEnter.MouseButton1Click:Connect(function()
    if PendingHubScript and ScriptPassInput.Text == PendingHubScript.Password then
        ScriptPassModal.Visible = false
        ExecuteScript(PendingHubScript.Code, PendingHubScript.Name)
        AddLog("✓ Autenticação aceita para " .. PendingHubScript.Name, Color3.fromRGB(100, 255, 160))
    else
        Notify("Segurança", "Senha incorreta ou inválida.")
    end
end)

